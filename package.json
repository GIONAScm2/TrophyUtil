{
	"name": "trophyutil",
	"description": "Isomorphic library of specialized trophy utilities",
	"author": {
		"name": "Matthew Gionas",
		"url": "https://github.com/GIONAScm2"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/GIONAScm2/TrophyUtil"
	},
	"keywords": [
		"PSN",
		"PSNProfiles",
		"Trophy hunting"
	],
	"version": "7.6.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"COPYING.txt"
	],
	"sideEffects": false,
	"scripts": {
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
		"test:file": "node --experimental-vm-modules node_modules/jest/bin/jest.js test/util/objCompare.test",
		"build": "tsc",
		"build:release": "tsc -p tsconfig.release.json",
		"prepublishOnly": "npm test && npm run build:release"
	},
	"license": "GPL-3.0-or-later",
	"devDependencies": {
		"@inrupt/jest-jsdom-polyfills": "^1.6.2",
		"@types/jest": "^29.5.1",
		"@types/jsdom": "^21.1.1",
		"@types/node": "^18.15.11",
		"enhanced-resolve": "^5.12.0",
		"jest": "^29.5.0",
		"jest-environment-jsdom": "^29.5.0",
		"jsdom": "^21.1.1",
		"ts-jest": "^29.1.0",
		"ts-node": "^10.9.1",
		"typescript": ">=5.1.3"
	}
}
