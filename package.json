{
	"name": "trophyutil",
	"description": "Isomorphic library of specialized trophy utilities",
	"author": {
		"name": "Matthew Gionas",
		"url": "https://github.com/GIONAScm2"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/GIONAScm2/TrophyUtil"
	},
	"keywords": [
		"PSN",
		"PSNProfiles",
		"Trophy hunting"
	],
	"version": "7.6.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"COPYING.txt"
	],
	"sideEffects": false,
	"scripts": {
		"test": "vitest run --root . --environment jsdom --globals --pool threads test",
		"test:watch": "vitest --root . --environment jsdom --globals --pool threads test",
		"test:file": "vitest run --root . --environment jsdom --globals --pool threads test/util/objCompare.test.ts",
		"typecheck": "tsc --noEmit -p tsconfig.test.json",
		"build": "tsc",
		"build:release": "tsc -p tsconfig.release.json",
		"prepack": "npm run build:release",
		"prepublishOnly": "npm test && npm run typecheck"
	},
	"license": "GPL-3.0-or-later",
	"devDependencies": {
		"@types/jsdom": "^28.0.1",
		"@types/node": "^25.6.0",
		"jsdom": "^29.1.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	}
}
